# Hosted database (Turso). Leave empty to use a local SQLite file in TOKENPOLICE_DATA.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TOKENPOLICE_DATA=./data
# Per-visitor name-edit limits behind a proxy that overwrites X-Forwarded-For (automatic on Vercel).
TRUST_PROXY=false
# Password for the /admin search-history page (12+ characters). Leave empty to disable it.
ADMIN_PASSWORD=
